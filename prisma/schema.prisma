generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum PostType {
  YAZI
  CEVIRI
}

// Yazılar ve çeviriler tek arşivde; tür ile ayrılır. Çeviriye özel alanlar
// (originalAuthor, originalTitle, originalLang, source*) yazıda boş kalır.
model Post {
  id              String     @id @default(cuid())
  type            PostType   @default(YAZI)
  // içeriğin dili: "tr" veya "fr" (listede ayrılmaz, birlikte görünür)
  lang            String     @default("tr")
  title           String
  slug            String     @unique
  excerpt         String
  content         String     @db.Text
  // false ise yalnızca özet gösterilir ve sourceUrl'e dış link verilir (telif)
  fullText        Boolean    @default(true)
  // ana sayfadaki "Öne çıkanlar" kaydırıcısında gösterilir
  featured        Boolean    @default(false)
  // yayımlandığı yer (dergi, sayı, sempozyum)
  publishedIn     String?
  originalAuthor  String?
  originalTitle   String?
  originalLang    String?
  // orijinal yayın ve yıl
  sourceCitation  String?
  sourceUrl       String?
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([status, type, publishedAt])
  @@index([status, featured, publishedAt])
}

// Tek satırlık ana sayfa (hero) ayarı: id her zaman "main"
model Hero {
  id          String   @id @default("main")
  headline    String
  description String?
  // Fransızca ana sayfa için tanıtım metni (boşsa Fransızca ana sayfada gösterilmez)
  descriptionFr String?
  updatedAt   DateTime @updatedAt
}

// Tek satırlık iletişim bilgisi: id her zaman "main"
model Contact {
  id        String   @id @default("main")
  email     String?
  phone     String?
  whatsapp  String?
  address   String?
  instagram String?
  updatedAt DateTime @updatedAt
}

// Tek satırlık "Hakkımda": id her zaman "main"
model About {
  id          String   @id @default("main")
  content     String   @db.Text
  // Fransızca "Présentation" sayfası metni (boşsa sayfa "yakında" gösterir)
  contentFr   String?  @db.Text
  updatedAt   DateTime @updatedAt
}

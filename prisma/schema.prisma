generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String
  content         String     @db.Text
  coverImageUrl   String?
  coverImageAlt   String?
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  categoryId      String?
  category        Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            Tag[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]
}

// Tek satırlık ana sayfa (hero) ayarı: id her zaman "main"
model Hero {
  id          String   @id @default("main")
  headline    String
  description String?
  buttonLabel String
  buttonUrl   String
  imageUrl    String?
  imageAlt    String?
  imageWidth  Int?
  imageHeight Int?
  updatedAt   DateTime @updatedAt
}

// Tek satırlık iletişim bilgisi: id her zaman "main"
model Contact {
  id        String   @id @default("main")
  email     String?
  phone     String?
  whatsapp  String?
  address   String?
  updatedAt DateTime @updatedAt
}

// Tek satırlık "Hakkımda": id her zaman "main"
model About {
  id          String   @id @default("main")
  content     String   @db.Text
  imageUrl    String?
  imageAlt    String?
  imageWidth  Int?
  imageHeight Int?
  updatedAt   DateTime @updatedAt
}
